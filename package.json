{
  "name": "homebridge-vogels-motionmount",
  "version": "2.0.0-alpha.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": "git@github.com:howm/homebridge-vogels-motionmount.git",
  "author": "howm",
  "description": "Homebridge plugin that support Vogel's motion mount",
  "license": "MIT",
  "private": false,
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "vogels",
    "motionmount",
    "bluetooth",
    "ble"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^2.0.0"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build": "pnpm clean && tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "homebridge": "^2.2.1",
    "node-gyp": "^13.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "homebridge": "^2.0.0"
  },
  "dependencies": {
    "@abandonware/noble": "^1.9.2-26"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@abandonware/bluetooth-hci-socket",
      "@abandonware/noble"
    ]
  }
}
